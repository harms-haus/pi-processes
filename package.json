{
  "name": "pi-processes",
  "version": "0.1.0",
  "description": "Process definitions and utilities for the pi framework",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "src/**/*.ts",
    "!src/__tests__/**",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "author": "harms-haus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harms-haus/pi-processes.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "processes"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.0.0"
  }
}
